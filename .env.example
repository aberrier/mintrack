# MinTrack configuration. Copy to .env next to docker-compose.yml, then fill in the two secrets.
# Keep it private: chmod 600 .env
# In the environment (not in this file), every MINTRACK__ variable can also be read from a file through a `_FILE`
# variant, for Docker secrets: MINTRACK__SECURITY__SECRET_KEY_FILE=mintrack_secret_key reads /run/secrets/...

# --- Docker Compose
# Database password, set when the volume is first created. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Published address. Behind a reverse proxy on the same host, use MINTRACK_BIND=127.0.0.1.
# MINTRACK_BIND=0.0.0.0

# --- MinTrack
# Public address, the root of an origin (no path). http:// works; installing the app and push need https://.
MINTRACK__PROJECT__PUBLIC_URL=http://localhost:8000

# Required, at least 32 characters. Generate with: openssl rand -hex 32. Back it up with the database.
MINTRACK__SECURITY__SECRET_KEY=change-me-to-the-output-of-openssl-rand-hex-32

# TMDB API key (free): https://www.themoviedb.org/settings/api. Without it, search and new pages are unavailable.
MINTRACK__TMDB__API_KEY=
# Language of titles and overviews from TMDB, such as en, fr or pt-BR. A change reaches each title at its next
# refresh (within a week).
# MINTRACK__TMDB__LANGUAGE=en

# Peers allowed to set X-Forwarded-For / X-Forwarded-Proto: your reverse proxy's exact address. With Docker Compose
# and a proxy on the host, that is 172.30.0.1. Empty: no one, the connecting address is the client.
# MINTRACK__SERVER__FORWARDED_ALLOW_IPS=172.30.0.1

# console | json
# MINTRACK__LOGGING__FORMAT=console
# debug | info | warning | error | critical
# MINTRACK__LOGGING__LEVEL=info
# Error reporting, off unless set. No personal data is sent.
# MINTRACK__LOGGING__SENTRY_DSN=
# Share of requests traced for performance (0.0 to 1.0).
# MINTRACK__LOGGING__SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Without Docker Compose (development, or an external PostgreSQL). Compose sets these from POSTGRES_*.
MINTRACK__DATABASE__HOST=localhost
MINTRACK__DATABASE__PORT=5432
MINTRACK__DATABASE__USER=mintrack
MINTRACK__DATABASE__PASSWORD=mintrack
MINTRACK__DATABASE__NAME=mintrack
# disable | allow | prefer | require | verify-ca | verify-full
# MINTRACK__DATABASE__SSLMODE=require
# MINTRACK__SERVER__HOST=127.0.0.1
# MINTRACK__SERVER__PORT=8000
# false when `mintrack worker` runs as its own service.
# MINTRACK__SERVER__RUN_WORKER=true
# TMDB's API address; browser tests point it at a fake.
# MINTRACK__TMDB__URL=https://api.themoviedb.org/3
# The built app to serve (the image sets /app/frontend). Unset: API only.
# MINTRACK__SERVER__FRONTEND_DIST=frontend/dist/frontend/browser

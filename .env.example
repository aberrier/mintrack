# Development only (`just dev`, `mintrack` commands from the repository): copy to .env at the repository root.
# An install sets its settings in docker-compose.yml instead; the README lists them all under Configuration.

# The database of `just dev-db`.
MINTRACK__DATABASE__HOST=localhost
MINTRACK__DATABASE__PORT=5432
MINTRACK__DATABASE__USER=mintrack
MINTRACK__DATABASE__PASSWORD=mintrack
MINTRACK__DATABASE__NAME=mintrack

# The address `just dev` answers at; `just dev-frontend` serves the app on :4200 and proxies /api to it.
MINTRACK__PROJECT__PUBLIC_URL=http://localhost:8000

# Optional outside production; at least 32 characters. Generate with: openssl rand -hex 32
# MINTRACK__SECURITY__SECRET_KEY=

# TMDB API key (free): https://www.themoviedb.org/settings/api. Without it, search and new pages are unavailable.
MINTRACK__TMDB__API_KEY=

# The built app to serve (`npm run build` in frontend/). Unset: API only.
# MINTRACK__SERVER__FRONTEND_DIST=frontend/dist/frontend/browser
# debug | info | warning | error | critical
# MINTRACK__LOGGING__LEVEL=info
